# Canonical public URL. Defaults to https://pagoblin.vercel.app when unset.
# Set this to the final custom domain once it exists.
NEXT_PUBLIC_SITE_URL=https://pagoblin.vercel.app

# Optional support address. Leave blank to send support to GitHub Issues.
# There is no mailbox on a custom domain yet.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional Plausible analytics. Off unless NEXT_PUBLIC_PLAUSIBLE_DOMAIN is set.
# Only page URLs and aggregate counts are sent; never file data or identities.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io
